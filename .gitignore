# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Training artifacts and model weights. Production weights are distributed
# out-of-band via GitHub Releases -- run `python scripts/fetch_models.py`.
data/
runs/

# Personal configs only. Everything else under configs/ is shared project data
# and IS tracked: map definitions, detection tuning, client settings.
# Each of these has a committed .example.ini template beside it.
configs/discord.ini
configs/game_data.ini
configs/keybindings.ini
configs/recordings.ini

# Trial records: per-machine movement-calibration experiment artifacts. Measured
# on one machine, by one character, against one client -- they mean nothing
# checked in. The *schedules* they run are tracked, under configs/trials/.
trial_records/

# Per-user launcher profiles (see profiles/example.yaml).
profiles/*.yaml
!profiles/example.yaml
# C extensions
*.so
# Logs
logs/

.idea/
.idea/misc.xml
# Claude Code: shared config and skills are tracked; personal overrides are not.
.claude/settings.local.json

